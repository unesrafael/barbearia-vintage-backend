# ---------------------------------------------------------------
# Copie este arquivo para .env e ajuste os valores.
#   cp .env.example .env
# ---------------------------------------------------------------

PORT=3333
NODE_ENV=development

# Postgres. Com o docker-compose deste repositório, use exatamente esta URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/barbearia

# Troque por uma string longa e aleatória antes de subir para produção:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-esta-chave-por-uma-string-aleatoria-longa
JWT_EXPIRES_IN=8h

# Origem do frontend. Separe por vírgula para aceitar mais de uma.
CORS_ORIGIN=http://localhost:5173

# Fuso da barbearia. O banco guarda em UTC; isto controla a exibição.
TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------------
# Automação (n8n)
# Deixe N8N_WEBHOOK_URL vazio para rodar o sistema sem a automação:
# os disparos aparecem apenas no log e nada quebra.
# ---------------------------------------------------------------
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=defina-o-mesmo-valor-no-no-webhook-do-n8n
N8N_TIMEOUT_MS=5000

# Dados que aparecem no e-mail enviado ao cliente.
BUSINESS_WHATSAPP=(11) 90000-0000
BUSINESS_ADDRESS=Rua das Palmeiras, 120 - São Paulo/SP
