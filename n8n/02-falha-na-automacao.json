        "jsCode": "const e = $json;\nreturn [{\n  json: {\n    workflow: e.workflow?.name ?? 'desconhecido',\n    mensagem: e.execution?.error?.message ?? 'sem mensagem',\n    no: e.execution?.lastNodeExecuted ?? '-',\n    quando: new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }),\n    url: e.execution?.url ?? '',\n  },\n}];"
      },
