      "parameters": {
        "fromEmail": "contato@barbeariavintage.com",
        "toEmail": "={{ $json.client.email }}",
        "subject": "={{ $json.computed.assunto }}",
        "emailFormat": "html",
        "html": "=<div style=\"font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #171a20; line-height: 1.6; max-width:520px; margin:0 auto; padding:8px;\">\n      <div style=\"height:5px; background:repeating-linear-gradient(115deg,#af1229 0 12px,#eef0f4 12px 24px,#27486f 24px 36px,#eef0f4 36px 48px); border-radius:99px;\"></div>\n      <h1 style=\"font-size:22px; margin:24px 0 4px;\">Boas-vindas, {{ $json.computed.primeiroNome }}!</h1>\n      <p style=\"margin:0; color:#5b6270;\">Este é o seu primeiro horário com a gente — já está reservado.</p>\n\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%; border-collapse:collapse; margin:22px 0; border:1px solid #dcdfe6; border-radius:8px; overflow:hidden;\">\n        <tr><td style=\"padding:11px 16px; background:#f4f5f7; font-size:12px; letter-spacing:.08em; text-transform:uppercase; color:#5b6270;\">Seu atendimento</td></tr>\n        <tr><td style=\"padding:14px 16px; border-top:1px solid #e8eaef;\"><strong>Serviço</strong><br>{{ $json.service.name }} &middot; {{ $json.computed.duracao }}</td></tr>\n        <tr><td style=\"padding:14px 16px; border-top:1px solid #e8eaef;\"><strong>Quando</strong><br>{{ $json.computed.quando }}</td></tr>\n        <tr><td style=\"padding:14px 16px; border-top:1px solid #e8eaef;\"><strong>Valor</strong><br>{{ $json.computed.preco }}</td></tr>\n        <tr><td style=\"padding:14px 16px; border-top:1px solid #e8eaef;\"><strong>Onde</strong><br>{{ $json.business.address }}</td></tr>\n      </table>\n      <p style=\"margin:0 0 8px;\"><strong>Para a sua primeira visita:</strong> chegue uns 5 minutinhos antes. Se precisar remarcar, é só chamar no WhatsApp {{ $json.business.whatsapp }}.</p>\n      <p style=\"margin:22px 0 0; color:#868d9b; font-size:13px;\">{{ $json.business.name }} &middot; {{ $json.business.address }}</p>\n    </div>",
        "options": {}
      },
