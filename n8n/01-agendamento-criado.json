    {
      "parameters": {
        "jsCode": "/**\n * \"A automação devera analisar suas informações e enviar um e-mail ao cliente.\"\n *\n * Este no faz a parte de analisar: normaliza o payload, converte o horário\n * para linguagem de gente, calcula o preço e decide o tom da mensagem.\n * O banco guarda em UTC; a API já mandou date/time no fuso da barbearia.\n */\nconst payload = $json.body ?? $json;\n\nconst { appointment, client, service, analysis, business } = payload;\n\nconst primeiroNome = client.name.trim().split(' ')[0];\n\n// \"2026-08-27\" -> \"27/08\"\nconst [ano, mes, dia] = appointment.date.split('-');\nconst dataCurta = `${dia}/${mes}`;\n\n// \"14:30\" -> \"14h30\"\nconst horaFalada = appointment.time.replace(':', 'h');\n\n// \"quinta-feira\" -> \"qui\"\nconst diaCurto = appointment.weekday.replace('-feira', '').slice(0, 3);\n\nconst quando = `${appointment.weekday}, ${appointment.dateLong}, às ${horaFalada}`;\n\n// Antecedencia: define se ainda faz sentido falar em \"amanha\" ou \"hoje\".\nconst horas = analysis.hoursUntilAppointment;\nlet antecedencia = '';\nif (horas < 0) antecedencia = 'registrado';\nelse if (horas < 12) antecedencia = 'ainda hoje';\nelse if (horas < 36) antecedencia = 'amanha';\nelse antecedencia = `em ${Math.round(horas / 24)} dias`;\n\nconst assunto = analysis.isFirstVisit\n  ? `${primeiroNome}, seu primeiro horário na ${business.name} está marcado — ${diaCurto} ${dataCurta} às ${horaFalada}`\n  : `Horário confirmado na ${business.name} — ${diaCurto} ${dataCurta} às ${horaFalada}`;\n\nreturn [{\n  json: {\n    ...payload,\n    computed: {\n      primeiroNome,\n      quando,\n      dataCurta,\n      horaFalada,\n      diaCurto,\n      antecedencia,\n      assunto,\n      preço: service.priceFormatted,\n      duração: `${service.durationMin} minutos`,\n      isFirstVisit: analysis.isFirstVisit,\n    },\n  },\n}];"
      },
      "id": "3db91629-9ff1-4d47-b441-b1a8bcd5b8f7",
      "name": "Analisar agendamento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        200
      ]
    },
