{
  "name": "barbearia-vintage-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API do sistema de agendamentos da Barbearia Vintage",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
